# Variable NAMES only. Copy to .env (git-ignored) and fill values locally.
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# RS256 (recommended): run scripts/gen-jwt-keys.sh. Private key -> auth-service only, public key -> api-gateway.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# HS256 fallback (dev only, min 32 bytes); ignored by the gateway when JWT_PUBLIC_KEY is set
JWT_SECRET=
API_KEY_HASH_PEPPER=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=
INTERNAL_SERVICE_TOKEN=
CHECKOUT_TOKEN_SECRET=
PUBLIC_BASE_URL=http://localhost:8080
WEBHOOK_SECRET_KEY=
API_KEY_HASH_PEPPER=

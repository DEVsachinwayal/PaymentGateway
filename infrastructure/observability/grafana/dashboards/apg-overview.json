{
 "uid": "apg-overview",
 "title": "APG overview",
 "tags": [
  "apg"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Payments finishing (per min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (to) (rate(apg_payment_transitions_total{to=~\"SUCCESS|FAILED|VERIFY_REQUIRED\"}[5m])) * 60",
     "legendFormat": "{{to}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Payment success ratio (10m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(apg_payment_transitions_total{to=\"SUCCESS\"}[10m])) / sum(rate(apg_payment_transitions_total{to=~\"SUCCESS|FAILED\"}[10m]))",
     "legendFormat": "success ratio"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Time from create to final state (p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, status) (rate(apg_payment_completion_seconds_bucket[10m])))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Provider calls by outcome (per min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, operation, outcome) (rate(apg_provider_calls_total[5m])) * 60",
     "legendFormat": "{{provider}} {{operation}} {{outcome}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Provider latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, provider, operation) (rate(apg_provider_call_seconds_bucket[5m])))",
     "legendFormat": "{{provider}} {{operation}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "HTTP 5xx ratio by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count[5m]))",
     "legendFormat": "{{application}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Provider callbacks: backlog / oldest (s) / dead",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "apg_webhook_backlog",
     "legendFormat": "backlog"
    },
    {
     "refId": "B",
     "expr": "apg_webhook_oldest_pending_seconds",
     "legendFormat": "oldest pending s"
    },
    {
     "refId": "C",
     "expr": "apg_webhook_dead",
     "legendFormat": "dead"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Merchant webhooks: backlog / dead",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "apg_webhook_delivery_backlog",
     "legendFormat": "backlog"
    },
    {
     "refId": "B",
     "expr": "apg_webhook_delivery_dead",
     "legendFormat": "dead"
    },
    {
     "refId": "C",
     "expr": "sum by (outcome) (rate(apg_webhook_delivery_total[5m])) * 60",
     "legendFormat": "{{outcome}}/min"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Outbox lag (s) by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "apg_outbox_oldest_unpublished_seconds",
     "legendFormat": "{{application}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Dead-letter records (15m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service, topic) (increase(apg_dlq_records_total[15m]))",
     "legendFormat": "{{service}} {{topic}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Kafka consumer lag",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (application) (kafka_consumer_fetch_manager_metrics_records_lag_max)",
     "legendFormat": "{{application}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Refunds: in flight / verify required / oldest (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "apg_refund_in_flight",
     "legendFormat": "in flight"
    },
    {
     "refId": "B",
     "expr": "apg_refund_verify_required",
     "legendFormat": "verify required"
    },
    {
     "refId": "C",
     "expr": "apg_refund_oldest_in_flight_seconds",
     "legendFormat": "oldest s"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Reconciliation: open exceptions / unreconciled batches",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "apg_reconciliation_open_exceptions",
     "legendFormat": "open exceptions"
    },
    {
     "refId": "B",
     "expr": "apg_settlements_unreconciled",
     "legendFormat": "unreconciled batches"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Ledger postings (per min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (rate(apg_ledger_postings_total[5m])) * 60",
     "legendFormat": "{{type}}"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "JVM heap used",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "{{application}}"
    }
   ]
  }
 ]
}